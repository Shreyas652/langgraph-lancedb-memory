# Required for the authenticated API. Provide actual values through your secret manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full
MEMORY_DB_PATH=data/service-memory.lance
OIDC_ISSUER=https://YOUR_ISSUER/
OIDC_AUDIENCE=YOUR_API_AUDIENCE
OIDC_JWKS_URL=https://YOUR_ISSUER/.well-known/jwks.json
MAX_CONVERSATION_MESSAGES=40
OPENAI_MODEL=YOUR_MODEL_NAME
# The operator sets exactly one provider key in the server's secret manager.
# Never include a provider key in a client app, browser bundle, or API response.
